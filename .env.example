# Copy to .env and replace the local database credentials for your PostgreSQL setup.
DATABASE_URL=postgresql+psycopg://returnpilot:change-me@localhost:5432/returnpilot

# Server-only credential shared by FastAPI's MCP client and the MCP server.
# Set a long random value before launching either backend process. Never expose it
# to the browser/model or commit .env.
MCP_SHARED_SECRET=

# Server-only HMAC-SHA-256 key for short-lived trusted actor contexts and approval grants.
# Use a random value of at least 32 bytes. Never expose it to the browser/model or commit .env.
GRANT_SIGNING_SECRET=

# Internal backend-to-MCP endpoint; this URL and its credential stay server-side.
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Server-only Google Gemini API configuration. Never expose the key to Vite/browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_ITERATIONS=4
GEMINI_TIMEOUT_SECONDS=20
